<?xml version="1.0" encoding="UTF-8"?>
<!-- Standard WiX wizard with native Windows Installer dual-purpose scope. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="DLsite Client"
    Manufacturer="DlsiteClient"
    Version="0.1.2"
    UpgradeCode="A7C3E2B1-5D4F-4A8E-9C21-0F6B8D3E1A42"
    Scope="perUserOrMachine"
    Compressed="yes"
    InstallerVersion="500">

    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="INSTALLSCOPE" Value="user" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <SetDirectory Id="INSTALLFOLDER" Value="[LocalAppDataFolder]Programs\DlsiteClient"
                  Condition="NOT Installed AND NOT INSTALLFOLDER AND MSIINSTALLPERUSER=1" />

    <Feature Id="Main" Title="DLsite Client" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DlsiteClient" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Dlsite Client" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="*">
        <File Id="AppExe" Source="!(bindpath.app)\DlsiteClient.App.exe" KeyPath="yes" />
      </Component>
      <Component Id="NativeGles" Guid="*">
        <File Source="!(bindpath.app)\av_libglesv2.dll" />
      </Component>
      <Component Id="NativeSqlite" Guid="*">
        <File Source="!(bindpath.app)\e_sqlite3.dll" />
      </Component>
      <Component Id="NativeHarfBuzz" Guid="*">
        <File Source="!(bindpath.app)\libHarfBuzzSharp.dll" />
      </Component>
      <Component Id="NativeSkia" Guid="*">
        <File Source="!(bindpath.app)\libSkiaSharp.dll" />
      </Component>
      <Component Id="SevenZipExe" Guid="*" Directory="ToolsDir">
        <File Source="!(bindpath.app)\tools\7z.exe" />
      </Component>
      <Component Id="SevenZipDll" Guid="*" Directory="ToolsDir">
        <File Source="!(bindpath.app)\tools\7z.dll" />
      </Component>
      <Component Id="SevenZipLicense" Guid="*" Directory="ToolsDir">
        <File Source="!(bindpath.app)\tools\License.txt" />
      </Component>
      <Component Id="LocaleJa" Guid="*" Directory="LocaleDir">
        <File Source="!(bindpath.app)\locales\ja.json" />
      </Component>
      <Component Id="LocaleZhTw" Guid="*" Directory="LocaleDir">
        <File Source="!(bindpath.app)\locales\zh-TW.json" />
      </Component>
    </ComponentGroup>

    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="LocaleDir" Name="locales" />
      <Directory Id="ToolsDir" Name="tools" />
    </DirectoryRef>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuDir" Guid="*">
      <Shortcut
        Id="StartMenuShortcut"
        Name="DLsite Client"
        Target="[INSTALLFOLDER]DlsiteClient.App.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKMU" Key="Software\DlsiteClient" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut
        Id="DesktopShortcut"
        Name="DLsite Client"
        Target="[INSTALLFOLDER]DlsiteClient.App.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKMU" Key="Software\DlsiteClient" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <UI>
      <Dialog Id="ScopeDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Installation scope" />
        <Control Id="Body" Type="Text" X="20" Y="55" Width="330" Height="30" Text="Choose who can use this application." />
        <Control Id="Scope" Type="RadioButtonGroup" X="20" Y="100" Width="330" Height="70" Property="INSTALLSCOPE">
          <RadioButtonGroup Property="INSTALLSCOPE">
            <RadioButton Value="user" X="0" Y="0" Width="320" Height="18" Text="Only for me (no administrator rights required)" />
            <RadioButton Value="machine" X="0" Y="30" Width="320" Height="18" Text="For all users (administrator rights required)" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Line" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Property="ALLUSERS" Value="2" Order="1" />
          <Publish Property="MSIINSTALLPERUSER" Value="1" Order="2" Condition="INSTALLSCOPE=&quot;user&quot;" />
          <Publish Property="MSIINSTALLPERUSER" Value="{}" Order="3" Condition="INSTALLSCOPE=&quot;machine&quot;" />
          <Publish Property="INSTALLFOLDER" Value="[LocalAppDataFolder]Programs\DlsiteClient" Order="4" Condition="INSTALLSCOPE=&quot;user&quot;" />
          <Publish Property="INSTALLFOLDER" Value="[ProgramFiles64Folder]DlsiteClient" Order="5" Condition="INSTALLSCOPE=&quot;machine&quot;" />
          <Publish Event="NewDialog" Value="InstallDirDlg" Order="6" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="ScopeDlg" Order="2" Condition="LicenseAccepted=1" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="ScopeDlg" Order="2" />
    </UI>
  </Package>
</Wix>
