<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX dual-scope x64 installer (AOT payload from artifacts/aot-win-x64).
  Default is per-user (ALLUSERS=2, MSIINSTALLPERUSER=1). The all-users button sets ALLUSERS=1 and carries the UAC shield.
  publish-msi.ps1 sets Word Count bit 3 so Explorer does not elevate before this dialog.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="DLsite Client"
    Manufacturer="DlsiteClient"
    Version="0.1.0"
    UpgradeCode="A7C3E2B1-5D4F-4A8E-9C21-0F6B8D3E1A42"
    Scope="perUserOrMachine"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="SCOPECHOSEN" Secure="yes" />

    <Feature Id="Main" Title="DLsite Client" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="InstallFolder" Name="DlsiteClient" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Dlsite Client" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="InstallFolder">
      <Component Id="MainExe" Guid="*">
        <File Id="AppExe" Source="!(bindpath.app)\DlsiteClient.App.exe" KeyPath="yes" />
      </Component>
      <Component Id="NativeGles" Guid="*">
        <File Source="!(bindpath.app)\av_libglesv2.dll" />
      </Component>
      <Component Id="NativeSqlite" Guid="*">
        <File Source="!(bindpath.app)\e_sqlite3.dll" />
      </Component>
      <Component Id="NativeHarfBuzz" Guid="*">
        <File Source="!(bindpath.app)\libHarfBuzzSharp.dll" />
      </Component>
      <Component Id="NativeSkia" Guid="*">
        <File Source="!(bindpath.app)\libSkiaSharp.dll" />
      </Component>
      <Component Id="LocaleJa" Guid="*" Directory="LocaleDir">
        <File Source="!(bindpath.app)\locales\ja.json" />
      </Component>
      <Component Id="LocaleZhTw" Guid="*" Directory="LocaleDir">
        <File Source="!(bindpath.app)\locales\zh-TW.json" />
      </Component>
    </ComponentGroup>

    <DirectoryRef Id="InstallFolder">
      <Directory Id="LocaleDir" Name="locales" />
    </DirectoryRef>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuDir" Guid="*">
      <Shortcut
        Id="StartMenuShortcut"
        Name="DLsite Client"
        Target="[InstallFolder]DlsiteClient.App.exe"
        WorkingDirectory="InstallFolder" />
      <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKMU" Key="Software\DlsiteClient" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut
        Id="DesktopShortcut"
        Name="DLsite Client"
        Target="[InstallFolder]DlsiteClient.App.exe"
        WorkingDirectory="InstallFolder" />
      <RegistryValue Root="HKMU" Key="Software\DlsiteClient" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <UI Id="InstallUi">
      <Dialog Id="ScopeDlg" Width="370" Height="175" Title="[ProductName]">
        <Control Id="Body" Type="Text" X="20" Y="20" Width="330" Height="36" Text="Install for the current user, or for all users of this PC." />
        <Control Id="PerUser" Type="PushButton" X="20" Y="70" Width="240" Height="17" Default="yes" Text="Install for me">
          <Publish Property="ALLUSERS" Value="2" Order="1" />
          <Publish Property="MSIINSTALLPERUSER" Value="1" Order="2" />
          <Publish Property="SCOPECHOSEN" Value="1" Order="3" />
          <Publish Event="EndDialog" Value="Return" Order="4" />
        </Control>
        <Control Id="PerMachine" Type="PushButton" X="20" Y="100" Width="240" Height="17" ElevationShield="yes" Text="Install for all users">
          <Publish Property="ALLUSERS" Value="1" Order="1" />
          <Publish Property="SCOPECHOSEN" Value="1" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="290" Y="145" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="ProgressDlg" Width="370" Height="80" Title="[ProductName]" Modeless="yes">
        <Control Id="Status" Type="Text" X="20" Y="15" Width="330" Height="12" TabSkip="no" Text="Installing...">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="40" Width="330" Height="12">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
      </Dialog>

      <Dialog Id="ErrorDlg" Width="270" Height="105" Title="[ProductName]" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="20" Y="10" Width="230" Height="50" />
        <Control Id="Y" Type="PushButton" X="50" Y="80" Width="56" Height="17" Text="Yes" />
        <Control Id="N" Type="PushButton" X="110" Y="80" Width="56" Height="17" Text="No" />
        <Control Id="A" Type="PushButton" X="170" Y="80" Width="56" Height="17" Text="Abort" />
        <Control Id="C" Type="PushButton" X="170" Y="80" Width="56" Height="17" Text="Cancel" />
        <Control Id="I" Type="PushButton" X="50" Y="80" Width="56" Height="17" Text="Ignore" />
        <Control Id="O" Type="PushButton" X="110" Y="80" Width="56" Height="17" Text="OK" />
        <Control Id="R" Type="PushButton" X="50" Y="80" Width="56" Height="17" Text="Retry" />
      </Dialog>

      <Dialog Id="FatalError" Width="270" Height="105" Title="[ProductName]">
        <Control Id="Text" Type="Text" X="20" Y="15" Width="230" Height="45" Text="Installation failed." />
        <Control Id="Finish" Type="PushButton" X="190" Y="75" Width="56" Height="17" Default="yes" Cancel="yes" Text="Close">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="UserExit" Width="270" Height="105" Title="[ProductName]">
        <Control Id="Text" Type="Text" X="20" Y="15" Width="230" Height="45" Text="Installation cancelled." />
        <Control Id="Finish" Type="PushButton" X="190" Y="75" Width="56" Height="17" Default="yes" Cancel="yes" Text="Close">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
    </UI>

    <InstallUISequence>
      <Show Dialog="ScopeDlg" Before="CostFinalize" Condition="NOT Installed AND NOT SCOPECHOSEN" />
      <Show Dialog="ProgressDlg" Before="ExecuteAction" />
    </InstallUISequence>
  </Package>
</Wix>
