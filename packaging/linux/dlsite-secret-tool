#!/bin/sh
set -eu
HERE="$(dirname "$(readlink -f "$0")")"
# KDE ships an activation name distinct from org.freedesktop.secrets.
if [ -f /usr/share/dbus-1/services/org.kde.secretservicecompat.service ]; then
    owner="$("$HERE/dbus-send" --session --dest=org.freedesktop.DBus --type=method_call --print-reply --reply-timeout=5000 /org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner string:org.freedesktop.secrets 2>/dev/null || true)"
    case "$owner" in
        *"boolean true"*) ;;
        *)
            names="$("$HERE/dbus-send" --session --dest=org.freedesktop.DBus --type=method_call --print-reply --reply-timeout=5000 /org/freedesktop/DBus org.freedesktop.DBus.ListActivatableNames 2>/dev/null || true)"
            case "$names" in
                *'"org.freedesktop.secrets"'*) ;;
                *) "$HERE/dbus-send" --session --dest=org.freedesktop.DBus --type=method_call --print-reply --reply-timeout=5000 /org/freedesktop/DBus org.freedesktop.DBus.StartServiceByName string:org.kde.secretservicecompat uint32:0 >/dev/null 2>&1 || true ;;
            esac ;;
    esac
fi
exec "$HERE/secret-tool" "$@"
